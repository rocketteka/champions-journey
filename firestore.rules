rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // App state per signed-in user (CRM, tracks, journey, etc.)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 4-digit student codes: teacher creates; parent/student claim link
    match /studentLinks/{code} {
      // Public get so auth form can prefill student name by ID (list still auth-only)
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.code == code;
      allow update: if request.auth != null && (
        resource.data.teacherUid == request.auth.uid
        || (
          request.resource.data.parentUid == request.auth.uid
          && (resource.data.parentUid == null || resource.data.parentUid == request.auth.uid)
        )
        || (
          request.resource.data.studentUid == request.auth.uid
          && (resource.data.studentUid == null || resource.data.studentUid == request.auth.uid)
        )
      );
      allow delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;
    }

    // Public enrollment applications from landing "Start learning"
    match /applications/{id} {
      allow create: if request.resource.data.source == 'land_cta'
        && request.resource.data.status == 'new'
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() <= 80
        && request.resource.data.parentName is string
        && request.resource.data.parentName.size() > 0
        && request.resource.data.parentName.size() <= 80
        && request.resource.data.parentPhone is string
        && request.resource.data.parentPhone.size() >= 10
        && request.resource.data.parentPhone.size() <= 32;
      allow read, update, delete: if request.auth != null;
    }

    // Optional bootstrap / docs marker — read-only for clients
    match /_meta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
